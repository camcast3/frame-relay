# Tailscale auth key from the admin console; prefer one tagged tag:apollo-hub.
TS_AUTHKEY=
# Copilot backend: mock, cli, or sdk.
ASL_COPILOT_BACKEND=mock
# GitHub token with Copilot entitlement; leave blank for mock mode.
ASL_COPILOT_TOKEN=
# Copilot model name; auto uses the app default.
ASL_COPILOT_MODEL=auto
