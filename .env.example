# Tailscale auth key from the admin console; prefer one tagged tag:frame-relay-hub.
TS_AUTHKEY=
# Copilot backend: mock, cli, or sdk.
FRAME_RELAY_COPILOT_BACKEND=mock
# GitHub token with Copilot entitlement; leave blank for mock mode.
FRAME_RELAY_COPILOT_TOKEN=
# Copilot model name; auto uses the app default.
FRAME_RELAY_COPILOT_MODEL=auto
# Shared secret authorizing on-demand host/client screenshots. Generate a long random value.
# The same value must be configured on the hub and collector-capable devices.
FRAME_RELAY_SCREENSHOT_TOKEN=

# Deprecated ASL_* names remain accepted during migration but should not be added to new setups.
