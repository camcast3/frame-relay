{
  // Merge this into your tailnet policy in the Tailscale admin console.
  "tagOwners": {
    "tag:apollo-hub": ["autogroup:admin"],
    "tag:apollo-collector": ["autogroup:admin"],
  },
  "grants": [
    {
      "src": ["tag:apollo-collector"],
      "dst": ["tag:apollo-hub"],
      "ip": ["tcp:443"],
    },
    {
      "src": ["autogroup:member"],
      "dst": ["tag:apollo-hub"],
      "ip": ["tcp:443"],
    },
  ],
}
